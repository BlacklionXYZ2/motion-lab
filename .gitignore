unity-spike/Library/
unity-spike/Temp/
unity-spike/Logs/
unity-spike/Builds/
unity-spike/UserSettings/
unity-spike/obj/
unity-spike/*.csproj
unity-spike/*.slnx
unity-spike/Assets/StreamingAssets/spike/
unity-spike/Assets/StreamingAssets/spike.meta

# Unity training environment (unity-env/): the same folders Unity generates for the spike
unity-env/Library/
unity-env/Temp/
unity-env/Logs/
unity-env/Builds/
unity-env/UserSettings/
unity-env/obj/
unity-env/*.csproj
unity-env/*.slnx

# Downloaded third-party models (motion-lab/external/README.md says what and where from)
external/*
!external/README.md

