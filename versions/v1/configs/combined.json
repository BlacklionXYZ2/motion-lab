{
 "name": "combined",
 "data": [
  "data/processed/lafan1",
  "data/processed/100style",
  "data/processed/cmu"
 ],
 "model": {
  "hidden": 256,
  "layers": 1,
  "head": "rotation"
 },
 "batch": 128,
 "window": 72,
 "warmup_ticks": 8,
 "steps": 40000,
 "learning_rate": 0.001,
 "weight_decay": 0.0001,
 "gradient_clip": 1.0,
 "input_noise": 0.03,
 "feedback_gradient": false,
 "signal_dropout": 0.3,
 "curriculum": [
  [
   0.0,
   1
  ],
  [
   0.3,
   8
  ],
  [
   0.6,
   32
  ]
 ],
 "validate_every": 1000,
 "validation_windows": 512,
 "seed": 1,
 "source_weights": {
  "lafan1": 1.0,
  "100style": 0.3,
  "cmu": 1.0
 },
 "storage": "cpu",
 "_notes": "LAFAN1 + 100STYLE + CMU (about 42 h); Bandai Namco to follow. 100STYLE weighted 0.3 so its stylised walking does not dominate. Data kept in system memory (rotations at half precision); only batches go to the GPU."
}
