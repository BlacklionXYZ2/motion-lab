   "conversation": 16,
   "emotion": 16,
   "attention": 16,
   "audio": 16,
   "context": 8,
   "locomotion": 16
  },
  "foot_lock": true
 },
 "init_from": "runs/latent-vel-free4/best.pt",
 "loss_weights": {
  "kl": 0.1,
  "kl_free_bits": 0.02,
  "foot_height": 2.0,
  "foot_skate": 0.5,
  "ground": 4.0,
  "self_contact": 4.0,
  "leg_cross": 4.0,
  "energy_floor": 1.0,
  "energy_ceiling": 0.5,
  "posture": 4.0,
  "jerk_ceiling": 0.2,
  "free_limits": 4.0,
  "track": 1.0,
  "free_skate": 0.5,
  "facing": 1.0
 },
