  "lafan1": 1.0,
  "100style": 0.3,
  "cmu": 1.0
 },
 "storage": "cpu",
 "_notes": "v5: the free10 recipe (foot lock with a 0.3 s flight limit, per-tick tracking, counterfactual commands, facing 1, energy floor 1, skate) started from latent-vel-free4 instead of free9: free4 has a sane body and never learned to glide to a command, while free9 inherits free7 gliding. A side-by-side test of whether the starting point matters.",
 "free_run": {
  "every": 3,
  "batch": 32,
  "context": 30,
  "ticks": 240,
  "start": 0.0,
  "noise_correlation": 0.98,
  "counterfactual": 2
 }
