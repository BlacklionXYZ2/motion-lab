{
 "name": "latent-vel-lock-sup2",
 "data": [
  "data/processed/lafan1",
  "data/processed/100style",
  "data/processed/cmu"
 ],
 "clean_data": true,
 "support_frame": true,
 "rare_intent_boost": 20.0,
 "velocity_lookahead": 30,
 "model": {
  "hidden": 256,
  "layers": 1,
  "head": "rotation",
  "latent": 32,
  "latent_width": 256,
  "signal_widths": {
   "intent": 32,
   "conversation": 16,
   "emotion": 16,
   "attention": 16,
   "audio": 16,
   "context": 8,
   "locomotion": 16
  },
  "foot_lock": true,
  "ground_lock": true
 },
 "init_from": "runs/latent-vel-lock-sup/step-3000.pt",
 "loss_weights": {
  "kl": 0.1,
  "kl_free_bits": 0.02,
  "foot_height": 2.0,
