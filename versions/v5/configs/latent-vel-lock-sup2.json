  [
   0.0,
   8,
   72
  ],
  [
   0.3,
   32,
   72
  ],
  [
   0.6,
   64,
   104
  ]
 ],
 "validate_every": 500,
 "validation_windows": 256,
 "seed": 17,
 "source_weights": {
  "lafan1": 1.0,
  "100style": 0.3,
  "cmu": 1.0
 },
 "storage": "cpu",
 "_notes": "v5: latent-vel-lock-sup continued for 3,000 more supervised-only steps under the locks: its validation was still improving at step 3,000 (root-velocity error 0.25 -> 0.16 m/s, foot skate 0.062 -> 0.035).",
 "keep_checkpoints": true
}
