  "lafan1": 1.0,
  "100style": 0.3,
  "cmu": 1.0
 },
 "storage": "cpu",
 "_notes": "v5: as latent-vel-free4 (a parallel branch from latent-vel-free3) plus following the velocity input in free runs (track, 1.0: achieved ground velocity per 0.5 s against the command turned into the world by her own heading). latent-vel-free3 reached a fifth of the asked speed and never turned to a new heading.",
 "free_run": {
  "every": 3,
  "batch": 32,
  "context": 30,
  "ticks": 240,
