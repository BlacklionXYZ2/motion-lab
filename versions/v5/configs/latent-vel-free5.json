{
 "name": "latent-vel-free5",
 "data": [
  "data/processed/lafan1",
  "data/processed/100style",
  "data/processed/cmu"
 ],
 "clean_data": true,
 "support_frame": true,
 "rare_intent_boost": 20.0,
 "velocity_lookahead": 30,
 "model": {
  "hidden": 256,
  "layers": 1,
  "head": "rotation",
  "latent": 32,
  "latent_width": 256,
  "signal_widths": {
