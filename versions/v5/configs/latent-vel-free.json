{
 "name": "latent-vel-free",
 "data": [
  "data/processed/lafan1",
  "data/processed/100style",
  "data/processed/cmu"
 ],
 "clean_data": true,
 "support_frame": true,
 "rare_intent_boost": 20.0,
 "velocity_lookahead": 30,
 "model": {
  "hidden": 256,
  "layers": 1,
  "head": "rotation",
  "latent": 32,
  "latent_width": 256,
  "signal_widths": {
   "intent": 32,
   "conversation": 16,
   "emotion": 16,
   "attention": 16,
   "audio": 16,
   "context": 8,
   "locomotion": 16
  }
 },
 "init_from": "runs/latent-b01/best.pt",
 "loss_weights": {
  "kl": 0.1,
  "kl_free_bits": 0.02,
  "foot_height": 2.0,
  "foot_skate": 0.5,
  "ground": 4.0,
  "self_contact": 4.0,
  "leg_cross": 4.0,
  "energy_floor": 0.5
 },
 "batch": 64,
 "window": 72,
 "warmup_ticks": 8,
 "steps": 5000,
 "learning_rate": 0.0003,
 "weight_decay": 0.0001,
 "gradient_clip": 1.0,
 "input_noise": 0.03,
 "feedback_gradient": false,
 "signal_dropout": 0.3,
 "curriculum": [
  [
   0.0,
   8,
   72
  ],
  [
   0.3,
   32,
   72
  ],
  [
   0.6,
   64,
   104
  ]
 ],
 "validate_every": 500,
 "validation_windows": 256,
 "seed": 2,
 "source_weights": {
  "lafan1": 1.0,
  "100style": 0.3,
  "cmu": 1.0
 },
 "storage": "cpu",
 "_notes": "v5 full recipe, latent: latent-b01 grown with the velocity input, plus free runs (4 s alone from 0.5 s of recording, prior samples) scored only on recording-free terms: ground (feet on the floor, flight to 10 cm), self_contact (no wrist in the torso), leg_cross, the joint and hips limits, and an energy floor of half the recorded window. The first latent model drifted into hovering (68%), wrists in the torso (14%) and 19.5% outside the limits in 5-minute runs: supervised rollouts never visit those states.",
 "free_run": {
  "every": 1,
  "batch": 32,
  "context": 30,
  "ticks": 240,
  "start": 0.0
 }
}
