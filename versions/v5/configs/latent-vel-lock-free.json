{
 "name": "latent-vel-lock-free",
 "data": [
  "data/processed/lafan1",
  "data/processed/100style",
  "data/processed/cmu"
 ],
 "clean_data": true,
 "support_frame": true,
 "rare_intent_boost": 20.0,
 "velocity_lookahead": 30,
 "model": {
  "hidden": 256,
  "layers": 1,
  "head": "rotation",
  "latent": 32,
  "latent_width": 256,
  "signal_widths": {
   "intent": 32,
   "conversation": 16,
   "emotion": 16,
   "attention": 16,
   "audio": 16,
   "context": 8,
   "locomotion": 16
  },
  "foot_lock": true,
  "ground_lock": true
 },
 "init_from": "runs/latent-vel-lock-sup/step-3000.pt",
 "loss_weights": {
  "kl": 0.1,
  "kl_free_bits": 0.02,
  "foot_height": 2.0,
  "foot_skate": 0.5,
  "ground": 4.0,
  "self_contact": 4.0,
  "leg_cross": 4.0,
  "energy_floor": 0.5,
  "energy_ceiling": 0.5,
  "posture": 4.0,
  "jerk_ceiling": 0.2,
  "free_limits": 4.0,
  "track": 1.0,
  "free_skate": 0.5,
  "facing": 0.5
 },
 "batch": 64,
 "window": 72,
 "warmup_ticks": 8,
 "steps": 3000,
 "learning_rate": 0.0003,
 "weight_decay": 0.0001,
 "gradient_clip": 1.0,
 "input_noise": 0.03,
 "feedback_gradient": false,
 "signal_dropout": 0.3,
 "curriculum": [
  [
   0.0,
   8,
   72
  ],
  [
   0.3,
   32,
   72
  ],
  [
   0.6,
   64,
   104
  ]
 ],
 "validate_every": 500,
 "validation_windows": 256,
 "seed": 18,
 "source_weights": {
  "lafan1": 1.0,
  "100style": 0.3,
  "cmu": 1.0
 },
 "storage": "cpu",
 "_notes": "v5: free runs back on top of a base that walks under the locks (lock-sup step 3,000, the first live foot-locked model): free13-style free runs (every third step, 4 s, noise 0.98, every second counterfactual with 75% of commands ahead, damped 8-tick feedback windows) at gentler weights (track 1, energy floor 0.5, facing 0.5). Learn to walk first, then to be steered.",
 "keep_checkpoints": true,
 "free_run": {
  "every": 3,
  "batch": 32,
  "context": 30,
  "ticks": 240,
  "start": 0.0,
  "noise_correlation": 0.98,
  "counterfactual": 2,
  "feedback_window": 8,
  "feedback_decay": 0.3,
  "cf_ahead_share": 0.75
 }
}
